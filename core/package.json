{
  "name": "@morfact/core",
  "version": "0.1.2",
  "description": "Composable, storage-agnostic workflow orchestration runtime — define DAGs, spawn child runs, route by condition, and execute hooks with built-in retry/lease/outbox.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Mozex Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/mozex/morfact"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "dag",
    "task",
    "dsl",
    "yaml",
    "composable",
    "storage-agnostic",
    "outbox",
    "lease",
    "plugin"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
